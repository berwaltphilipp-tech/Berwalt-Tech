# Einstellungen des Dashboards.
#
# Normalerweise füllt setup.sh (bzw. proxmox-install.sh) diese Datei automatisch.
# Von Hand:  cp .env.example .env  und die Werte anpassen.

# --- Server --------------------------------------------------------------------

# Adresse(n), unter denen das Dashboard aufgerufen wird, jeweils mit Port 3000.
# Mehrere Einträge mit Komma trennen, OHNE Leerzeichen.
HOMEPAGE_ALLOWED_HOSTS=192.168.1.10:3000

# IP-Adresse des Rechners, auf dem das Dashboard läuft (ohne Port)
HOMEPAGE_VAR_SERVER_IP=192.168.1.10

# --- Messwerte (Glances) -------------------------------------------------------

# "glances" = Glances läuft als Docker-Container neben dem Dashboard.
# Leer lassen, wenn Glances woanders läuft (Proxmox: direkt auf dem Host).
COMPOSE_PROFILES=glances

# Adresse von Glances (Proxmox: http://<PROXMOX-IP>:61208)
HOMEPAGE_VAR_GLANCES_URL=http://192.168.1.10:61208

# Netzwerkkarte, deren Traffic (rein/raus) angezeigt wird.
# Herausfinden:  ip -br link   (Proxmox: vmbr0, sonst z. B. eth0, enp3s0, eno1)
HOMEPAGE_VAR_NET_IFACE=eth0

# Festplatte für die Lese-/Schreib-Anzeige.
# Herausfinden:  lsblk -d -o NAME   (z. B. sda, nvme0n1)
HOMEPAGE_VAR_DISK=sda

# Pfad des Systemlaufwerks aus Sicht von Glances:
#   "/rootfs" wenn Glances im Docker-Container läuft, "/" wenn direkt auf dem Host
HOMEPAGE_VAR_ROOTFS=/rootfs

# Temperatursensor der CPU. Liste aller Sensoren: <GLANCES-ADRESSE>/api/4/sensors
#   Intel: "Package id 0"   AMD: "Tctl"   Raspberry Pi: "cpu_thermal 0"
HOMEPAGE_VAR_CPU_SENSOR=Package id 0

# --- Proxmox -------------------------------------------------------------------
# Wird von proxmox-install.sh automatisch ausgefüllt (API-Token nur mit Leserechten)

HOMEPAGE_VAR_PVE_URL=https://192.168.1.2:8006
HOMEPAGE_VAR_PVE_NODE=pve
HOMEPAGE_VAR_PVE_TOKEN_ID=
HOMEPAGE_VAR_PVE_TOKEN_SECRET=

# --- Router --------------------------------------------------------------------
# Aufbau: Internet -> FRITZ!Box 6690 -> UDM -> Heimnetz

# FRITZ!Box (misst den gesamten Internet-Traffic rein/raus).
# Ist auch hinter der UDM erreichbar, Standard-Adresse: http://192.168.178.1
HOMEPAGE_VAR_FRITZBOX_URL=http://192.168.178.1

# UniFi Dream Machine (Geräte in LAN/WLAN)
HOMEPAGE_VAR_UNIFI_URL=https://192.168.1.1

# Anmeldung an der UDM: ENTWEDER einen API-Schlüssel eintragen (empfohlen) ...
#   UniFi Network -> Einstellungen -> Control Plane -> Integrations -> API-Schlüssel erstellen
HOMEPAGE_VAR_UNIFI_KEY=
# ... ODER einen lokalen Benutzer mit Rolle "Nur ansehen" (dann Schlüssel leer lassen)
HOMEPAGE_VAR_UNIFI_USER=
HOMEPAGE_VAR_UNIFI_PASS=

# --- Sonstiges -----------------------------------------------------------------

TZ=Europe/Berlin
